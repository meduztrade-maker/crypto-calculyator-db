FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY bot/ ./bot/
COPY webapp/ ./webapp/
COPY assets/ ./assets/
COPY alembic/ ./alembic/
COPY alembic.ini .

EXPOSE 8080

CMD ["sh", "-c", "alembic upgrade head && uvicorn webapp.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
