# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAExampleTokenReplaceMe

# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL
# when you attach a Postgres plugin to the service)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Telegram numeric user ID of the bot owner/admin (get it from @userinfobot)
ADMIN_ID=123456789

# Private Telegram channel ID used for database backups.
# Add the bot as admin to a private channel, post any message, and use
# a tool like @RawDataBot to read the channel id (starts with -100...)
BACKUP_CHANNEL_ID=-1001234567890

# IANA timezone used for daily/weekly report boundaries
TIMEZONE=Asia/Tashkent

# Default margin (USD) used to seed new users' leverage calculator (optional)
DEFAULT_MARGIN=500
